{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/sync-docs.ps1\" -Mode PostEdit",
            "asyncRewake": true,
            "timeout": 120,
            "statusMessage": "Updating index, readme headers and link check"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/sync-docs.ps1\" -Mode Stop",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
